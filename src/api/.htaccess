# Секреты и журнал не должны отдаваться браузером.
# Внимание: на nginx этот файл не действует вовсе — там нужно правило в конфиге сервера.
# Кнопка «Проверить окружение» в панели показывает, закрыт журнал на самом деле или нет.

<FilesMatch "^(config\.php|config - example\.php|lib\.php)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 /logs/
RedirectMatch 404 \.jsonl$

Options -Indexes
